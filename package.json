{
  "name": "starkmacher",
  "productName": "Starkmacher",
  "version": "0.1.0",
  "private": true,
  "description": "Starkmacher – persönlicher Nährstoffbedarf, Lebensmittel, Rezepte, Teller und Tagebuch. Mac-Programm (Electron), komplett offline.",
  "author": "Lukas",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/bls-bauen.mjs --wenn-fehlt && electron-vite build && playwright test",
    "symbol": "electron scripts/programmsymbol.mjs",
    "bls": "node scripts/bls-bauen.mjs",
    "paket": "node scripts/bls-bauen.mjs --wenn-fehlt && electron-vite build && electron-builder --mac --dir"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
